# Local-only starting point; never commit .env or production credentials.
# Copy to pod-provider/backend/.env for an isolated development environment.
# Production secrets come from a dedicated deployment secret manager.
# Intentionally leave security-sensitive variables empty until securely provisioned.
SEMAPPS_INSTANCE_NAME=ActivityPods local
SEMAPPS_INSTANCE_DESCRIPTION_EN=Local ActivityPods provider
SEMAPPS_INSTANCE_DESCRIPTION_FR=
SEMAPPS_INSTANCE_OWNER=
SEMAPPS_INSTANCE_AREA=Local
SEMAPPS_AVAILABLE_LOCALES=en,fr
SEMAPPS_DEFAULT_LOCALE=en
SEMAPPS_ENABLE_GROUPS=false
SEMAPPS_HOME_URL=http://localhost:3000
SEMAPPS_PORT=3000
SEMAPPS_FRONTEND_URL=http://localhost:4000
SEMAPPS_SHAPE_REPOSITORY_URL=
SEMAPPS_MAPBOX_ACCESS_TOKEN=
SEMAPPS_COLOR_PRIMARY=
SEMAPPS_COLOR_SECONDARY=
SEMAPPS_SPARQL_ENDPOINT=http://localhost:3030/
SEMAPPS_JENA_USER=admin
SEMAPPS_JENA_PASSWORD=
SEMAPPS_FUSEKI_BASE=http://localhost:3030/
SEMAPPS_REDIS_CACHE_URL=redis://localhost:6379
SEMAPPS_QUEUE_SERVICE_URL=redis://localhost:6379
SEMAPPS_REDIS_TRANSPORTER_URL=redis://localhost:6379
SEMAPPS_REDIS_OIDC_PROVIDER_URL=redis://localhost:6379
SEMAPPS_COOKIE_SECRET=
SEMAPPS_FROM_EMAIL=
SEMAPPS_FROM_NAME=
SEMAPPS_SMTP_HOST=
SEMAPPS_SMTP_PORT=
SEMAPPS_SMTP_SECURE=false
SEMAPPS_SMTP_USER=
SEMAPPS_SMTP_PASS=
SEMAPPS_AUTH_RESERVED_USER_NAMES=admin,root
SEMAPPS_AUTH_ACCOUNTS_DATASET=settings
SEMAPPS_BACKUP_COPY_METHOD=
SEMAPPS_BACKUP_SERVER_PATH=
SEMAPPS_BACKUP_SERVER_HOST=
SEMAPPS_BACKUP_SERVER_USER=
SEMAPPS_BACKUP_SERVER_PASSWORD=
SEMAPPS_BACKUP_SERVER_PORT=
SIDECAR_WEBHOOK_URL=
SIDECAR_DELIVERY_HANDOFF_URL=
SIDECAR_TOKEN=
ACTIVITYPODS_TOKEN=
SIGNING_API_TOKEN=
PDQ_HASH_SERVICE_BASE_URL=
